*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Database files
*.db
*.sqlite
*.sqlite3

# Environment variables
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Uploads (user-generated content)
static/uploads/

# Test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
.pytest_cache/

# Model files (large binary files)
*.pt
*.pth
*.onnx
*.weightsinstance/
weights/
backup_static/
backup_templates/
cascades/
.pytest_cache/
__pycache__/
*.log
*_output.txt
*_out.txt
test_baseline.txt
test_fail_detail.txt
test_result.txt
pip_install_log*.txt
